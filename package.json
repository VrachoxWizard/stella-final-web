{
  "name": "tina-sport-pia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "build": "tinacms build && next build",
    "build:local": "tinacms build --local --skip-cloud-checks && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tinacms": "^3.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@tinacms/cli": "^2.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "typescript": "^5.9.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "@module-federation/dts-plugin": {
      "undici": "7.29.0"
    },
    "@vercel/frameworks": {
      "js-yaml": "3.15.0",
      "smol-toml": "1.7.1"
    },
    "typeid-js": {
      "uuid": "11.1.1"
    }
  }
}
